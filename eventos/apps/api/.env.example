# ===================================================
# Finora Experience - API Environment Configuration
# ===================================================

# Porta de execução da API NestJS
PORT=3334
NODE_ENV=production

# Conexão com o banco de dados MariaDB / MySQL
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://grqm_finora:SUA_SENHA_AQUI@localhost:3306/grqm_finora"
DATABASE_CONNECTION_LIMIT=25

# ===================================================
# Segurança e Conformidade LGPD (Obrigatório)
# ===================================================
# Chave para HMAC-SHA256 do CPF (busca segura sem expor CPF bruto)
CPF_HASH_SECRET="SUA_CHAVE_SECRETA_HMAC_CPF"

# Chave AES-256-GCM (exatamente 32 bytes em Base64 - ex: openssl rand -base64 32)
DATA_ENCRYPTION_KEY="SUA_CHAVE_AES_32_BYTES_BASE64_AQUI"

# Chave secreta de proteção das rotas administrativas da API
FINORA_ADMIN_API_KEY="SUA_CHAVE_SECRETA_ADMIN_AQUI"

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://seu-dominio.com.br"

# ===================================================
# Integração Z-API (WhatsApp)
# ===================================================
ZAPI_INSTANCE_ID="SUA_INSTANCIA_ZAPI"
ZAPI_TOKEN="SEU_TOKEN_ZAPI"
ZAPI_CLIENT_TOKEN="SEU_CLIENT_TOKEN_OPCIONAL"
DISABLE_WHATSAPP="false"

# Parâmetros de Cadência Anti-Ban da Fila WhatsApp (Opcionais com valores padrão seguros)
# WHATSAPP_MIN_DELAY_MS=180000
# WHATSAPP_MAX_DELAY_MS=360000
# WHATSAPP_MAX_PER_HOUR=15
# WHATSAPP_BUSINESS_START=9
# WHATSAPP_BUSINESS_END=20
# WHATSAPP_IGNORE_BUSINESS_HOURS=false
