// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  message   String
  status    String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  sector      String   @default("")
  photo       String?  // public path or /api/files/<upload>
  accentColor String   @default("#14d0c1")
  linkedin    String?
  bio         String?  @db.Text
  order       Int      @default(0)

  responsibleDeals CrmCard[]         @relation("DealResponsible")
  observedDeals    CrmDealObserver[]
  activities       CrmActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String   // qual pagina acessou (ex: /auditoria, /technology)
  referrer  String?  // de onde veio (ex: google.com)
  userAgent String?
  createdAt DateTime @default(now())
}

// ==========================================
// CRM MODULE
// ==========================================

model CrmPipeline {
  id           String     @id @default(cuid())
  name         String
  stages       CrmStage[]
  fieldsConfig Json?      // Array of field definitions
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CrmStage {
  id          String          @id @default(cuid())
  name        String
  order       Int             @default(0)
  pipelineId  String
  pipeline    CrmPipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards       CrmCard[]
  automations CrmAutomation[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A deal (negócio) shown as a card on the kanban.
model CrmCard {
  id          String        @id @default(cuid())
  /// Short sequential number used in the URL: /crm/deal/details/<number>
  number      Int           @unique @default(autoincrement())
  title       String
  /// Cached sum of the deal products (kept in sync by the API) so the board doesn't aggregate on every load
  value       Decimal       @default(0.00) @db.Decimal(10, 2)
  currency    String        @default("BRL") @db.VarChar(3)
  status      CrmDealStatus @default(OPEN)
  order       Int           @default(0)
  startDate   DateTime?     @db.Date
  closeDate   DateTime?     @db.Date
  dealType    String?
  source      String?
  sourceInfo  String?       @db.Text
  isPublic    Boolean       @default(true)
  comment     String?       @db.Text
  recurrence  CrmRecurrence @default(NONE)
  utm         Json?         // { source, medium, campaign, content, term } captured from forms
  customData  Json?         // values of the pipeline's user-defined fields (fieldsConfig)

  stageId       String
  stage         CrmStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  companyId     String?
  company       CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible   TeamMember? @relation("DealResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  contacts   CrmDealContact[]
  observers  CrmDealObserver[]
  products   CrmDealProduct[]
  activities CrmActivity[]
  history    CrmHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, order])
  @@index([companyId])
  @@index([responsibleId])
}

/// Companies are shared between deals: editing one updates every deal linked to it.
model CrmCompany {
  id        String       @id @default(cuid())
  name      String
  document  String?      @unique // CNPJ
  phone     String?
  email     String?
  address   String?
  info      String?      @db.Text
  deals     CrmCard[]
  contacts  CrmContact[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([name])
}

model CrmContact {
  id        String           @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  info      String?          @db.Text
  companyId String?
  company   CrmCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals     CrmDealContact[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([name])
  @@index([companyId])
}

/// Contacts (participantes) of a deal; the lowest `order` is the main contact.
model CrmDealContact {
  dealId    String
  deal      CrmCard    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order     Int        @default(0)

  @@id([dealId, contactId])
  @@index([contactId])
}

model CrmDealObserver {
  dealId   String
  deal     CrmCard    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([dealId, memberId])
  @@index([memberId])
}

/// Product/service catalog.
model CrmProduct {
  id        String           @id @default(cuid())
  name      String           @unique
  price     Decimal          @default(0.00) @db.Decimal(10, 2)
  dealItems CrmDealProduct[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

/// Product line of a deal. Name and price are a snapshot of the sale, so later
/// catalog changes don't rewrite closed deals.
model CrmDealProduct {
  id        String      @id @default(cuid())
  dealId    String
  deal      CrmCard     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String?
  product   CrmProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal     @default(0.00) @db.Decimal(10, 2)
  quantity  Int         @default(1)
  order     Int         @default(0)

  @@index([dealId])
  @@index([productId])
}

enum CrmActivityType {
  TODO
  TASK
  CALL
  MEETING
  COMMENT
}

model CrmActivity {
  id            String          @id @default(cuid())
  cardId        String
  card          CrmCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type          CrmActivityType
  title         String          @db.Text
  description   String?         @db.Text
  deadline      DateTime?
  responsibleId String?
  responsible   TeamMember?     @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  completed     Boolean         @default(false)
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([cardId])
  @@index([responsibleId])
}

/// Append-only audit log of the deal timeline. `data` is a snapshot of the change
/// (names, old/new values) so entries stay readable after related rows change.
model CrmHistory {
  id        String   @id @default(cuid())
  cardId    String
  card      CrmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type      String   // CREATED, STAGE_CHANGED, FIELD_CHANGED, STATUS_CHANGED, RECURRENCE_CREATED
  data      Json?
  createdAt DateTime @default(now())

  @@index([cardId])
}

model CrmAutomation {
  id         String   @id @default(cuid())
  name       String
  actionType String   // ex: 'WEBHOOK', 'SEND_EMAIL', 'CREATE_TASK'
  config     Json?    // config json
  stageId    String
  stage      CrmStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
