// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  message   String
  status    String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photo     String
  linkedin  String?
  bio       String?  @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String   // qual pagina acessou (ex: /auditoria, /technology)
  referrer  String?  // de onde veio (ex: google.com)
  userAgent String?
  createdAt DateTime @default(now())
}

// ==========================================
// CRM MODULE
// ==========================================

model CrmPipeline {
  id           String     @id @default(cuid())
  name         String
  stages       CrmStage[]
  fieldsConfig Json?      // Array of field definitions
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CrmStage {
  id          String          @id @default(cuid())
  name        String
  order       Int             @default(0)
  pipelineId  String
  pipeline    CrmPipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards       CrmCard[]
  automations CrmAutomation[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CrmCard {
  id         String    @id @default(cuid())
  title      String
  company    String?
  value      Decimal   @default(0.00) @db.Decimal(10, 2)
  order      Int       @default(0)
  customData Json?     // JSON object storing dynamic field values
  stageId    String
  stage      CrmStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  activities CrmActivity[]
  products   CrmProduct[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CrmActivity {
  id        String   @id @default(cuid())
  type      String   // 'COMMENT', 'TASK', 'MEETING', 'SYSTEM'
  content   String   @db.Text
  dueDate   DateTime?
  isDone    Boolean  @default(false)
  cardId    String
  card      CrmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmProduct {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)
  cardId    String
  card      CrmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CrmAutomation {
  id         String   @id @default(cuid())
  name       String
  actionType String   // ex: 'WEBHOOK', 'SEND_EMAIL', 'CREATE_TASK'
  config     Json?    // config json
  stageId    String
  stage      CrmStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
