{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-dev-redis",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "REDIS_URL": "redis://127.0.0.1:6379"
      },
      "port": 3000
    },
    {
      "name": "proposta",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "proposta", "run", "dev"],
      "port": 3005
    }
  ]
}
