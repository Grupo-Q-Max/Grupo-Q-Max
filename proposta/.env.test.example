PORT=3005

# Configurações do Banco de Dados para Testes
# RECOMENDADO: Crie um schema separado no MySQL (ex: proposta_test) ou aponte para um banco de teste local
DB_HOST=127.0.0.1
DB_USER=seu_usuario_de_teste
DB_PASS=sua_senha_de_teste
DB_NAME=proposta_test
DB_PORT=3306
DB_SSL=false

# Configurações de E-mail
EMAIL_USER=envio@qmax.com.br
NOTIFY_EMAIL=responsavel@dominio.com.br
RESEND_API_KEY=
EMAIL_FROM=FINORA <propostas@seudominio.com.br>

# Configurações OAuth 2.0 Outlook Corporativo (Opcional para testes locais)
OAUTH_CLIENT_ID=placeholder_client_id
OAUTH_CLIENT_SECRET=placeholder_client_secret
OAUTH_REFRESH_TOKEN=placeholder_refresh_token
OAUTH_TENANT_ID=placeholder_tenant_id
BASE_URL=http://localhost:3005
APP_BASE_PATH=/proposta
JWT_SECRET=Finora@QMax_2026_SecureKey_Test!

# Configurações D4Sign (Recomendado usar URL de Sandbox para testes)
# Se as chaves contiverem "placeholder", o d4signService entrará em modo MOCK automatico
D4SIGN_API_TOKEN=placeholder_d4sign_token
D4SIGN_API_SECRET=placeholder_d4sign_secret
D4SIGN_API_URL=https://sandbox.d4sign.com.br/api/v1
D4SIGN_UUID_COFRE=placeholder_d4sign_uuid_cofre

# E-mail interno para testes em sandbox (plus-addressing: teste+cliente@..., teste+socio@...)
D4SIGN_EMAIL_INTERNO_TESTE=teste@grupoqmax.com.br

# E-mail do representante da Q-MAX para assinatura em dupla
EMAIL_REPRESENTANTE_QMAX=contato@grupoqmax.com.br

# Segredos de Webhook para testes
WEBHOOK_SECRET=placeholder_webhook_secret
D4SIGN_WEBHOOK_SECRET=placeholder_d4sign_webhook_secret

# Chave de criptografia de certificados (mínimo 32 caracteres)
CERTIFICADO_ENCRYPTION_KEY=RB0dT344lLMfQJfCYu36+wK5WZVuSpF9KzYEob4/hyUPX2+s/gpxXY1J8J+2gAbQ
