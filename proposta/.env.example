# Porta do servidor
PORT=3000

# Configurações do Banco de Dados MySQL
DB_HOST=seu_host_mysql
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=nome_do_banco
DB_PORT=3306
# true para Azure MySQL (exige TLS)
DB_SSL=false

# Configurações de E-mail (Opção 1: Resend - Recomendada, Gratuita e Sem Expiração)
RESEND_API_KEY=re_sua_chave_aqui
EMAIL_FROM=FINORA <propostas@seudominio.com.br>

# Configurações OAuth 2.0 (Opção 2: Outlook Corporativo / Fallback)
EMAIL_USER=seu_email@dominio.com.br
# E-mail que recebe notificações de proposta aprovada
NOTIFY_EMAIL=responsavel@dominio.com.br
OAUTH_CLIENT_ID=seu-client-id
OAUTH_CLIENT_SECRET=seu-client-secret
OAUTH_REFRESH_TOKEN=seu-refresh-token
OAUTH_TENANT_ID=seu-tenant-id

# URL base pública da aplicação (sem barra final)
BASE_URL=https://seudominio.com

# Caminho base da aplicação
APP_BASE_PATH=/proposta

# Segredo para geração de JWT
JWT_SECRET=mude-para-um-segredo-forte-em-producao

# Ambiente (development | production)
NODE_ENV=production

# Configurações D4Sign
D4SIGN_API_TOKEN=seu_token_api_d4sign
D4SIGN_API_SECRET=seu_secret_api_d4sign
D4SIGN_API_URL=https://sandbox.d4sign.com.br/api/v1
D4SIGN_UUID_COFRE=seu_uuid_cofre_d4sign

# E-mail do representante da Q-MAX para assinatura em dupla
EMAIL_REPRESENTANTE_QMAX=contato@grupoqmax.com.br

# Segredo exigido em /api/webhooks/* (header X-Webhook-Secret ou ?secret=)
WEBHOOK_SECRET=

# Opcional: segredo próprio do webhook D4Sign (senão usa a cryptKey)
D4SIGN_WEBHOOK_SECRET=

# Chave de criptografia para senhas de certificados digitais (mínimo 32 caracteres)
CERTIFICADO_ENCRYPTION_KEY=
