# Signs the CRM session and /admin cookies. Required in production (the app refuses to sign without it)
AUTH_SECRET="string-aleatoria-longa"
# /admin password when none was saved from the admin screen. No built-in default: unset = admin locked
ADMIN_PASSWORD=""
# CRM sign-in with Microsoft Entra ID (README > Login do CRM). Required: no defaults
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_ALLOWED_DOMAINS="grupoqmax.com.br"
# Public URL used in invitation e-mails in production (default https://qmaxbrasil.com.br)
APP_URL="https://qmaxbrasil.com.br"
# E-mail (lib/mail.ts): Office 365 SMTP, STARTTLS
MAIL_FROM="crm@grupoqmax.com.br"
MAIL_FROM_NAME="Q-Max CRM"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="crm@grupoqmax.com.br"
# Fallback when OAuth is not set or fails (needs SMTP AUTH enabled on the mailbox)
SMTP_PASS=""
# OAuth2 / XOAUTH2 (tried first): refresh token exchanged for an SMTP.Send access token
OAUTH_TENANT_ID=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_REFRESH_TOKEN=""
OAUTH_REDIRECT_URI=""
DATABASE_URL="mysql://usuario:senha@host:porta/banco_de_dados"
# QXBACK (referral program) talks to the CRM as if it were Bitrix24: base URL
# <APP_URL>/api/crm/qxback/<QXBACK_TOKEN>/ (lib/crm-qxback.ts)
QXBACK_TOKEN=
# Bitrix stage code -> CrmStage.id. QXBACK's scripts read these 8: C1:NEW, C1:PREPARATION (em contato),
# C1:PREPAYMENT_INVOICE (indicação boa), C1:UC_WZ7S1B (proposta), C1:UC_TGGJ1J (fechado parcial),
# C1:WON, C1:APOLOGY (perdido), C1:UC_MO1HGQ (contato recusado). e.g. {"C1:NEW":"cm...","C1:WON":"cm..."}
# Moving a deal into C1:UC_WZ7S1B/C1:EXECUTING (Proposta em Análise) requires services with a price;
# into C1:APOLOGY (Negócio Perdido) asks for the reason (saved in UF_CRM_1745841118729 below).
QXBACK_STAGES=
# Bitrix UF_ field -> pipeline custom field id. Needed: UF_CRM_INDICACAO_ID (ID da indicação),
# UF_CRM_1764593798 (serviços fechados, "a; b"), UF_CRM_1745841118729 (motivo da perda, read by
# negocio_perdido.php). e.g. {"UF_CRM_1764593798":"abc12","UF_CRM_1745841118729":"def34"}
QXBACK_FIELDS=
# Outgoing: QXBACK's backend/bitrix_webhook_handler.php URL. Called with ONCRMDEALUPDATE when a QXBACK
# deal's products/value/comment change here, and ONCRMDEALSTAGE (+ STAGE_ID) when a deal enters a mapped stage
QXBACK_WEBHOOK_URL=
# Shared secret QXBACK checks against its own QXBACK_WEBHOOK_SECRET env (not the Bitrix token)
QXBACK_WEBHOOK_SECRET=
